.login-page {
  min-height: 100vh;
  background: #0f0f1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-text {
  font-size: 64rpx;
  font-weight: bold;
  color: #7c6af7;
  letter-spacing: 4rpx;
}

.logo-sub {
  font-size: 26rpx;
  color: #555;
  margin-top: 12rpx;
}

.form-wrap {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  color: #888;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  background: #1a1a2e;
  border: 2rpx solid #2a2a3e;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  color: #eee;
  font-size: 30rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #444;
}

.error-msg {
  color: #e06c75;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  background: #7c6af7;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 28rpx 0;
  border: none;
  margin-top: 16rpx;
}

.submit-btn[loading] {
  opacity: 0.7;
}