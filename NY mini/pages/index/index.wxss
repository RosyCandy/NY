page {
  background: #0f0f1a;
}

.container {
  min-height: 100vh;
  padding: 100rpx 30rpx 120rpx;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

/* 菜单按钮 */
.menu-btn {
  position: fixed;
  top: 24rpx;
  right: 30rpx;
  z-index: 999;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.menu-line {
  width: 44rpx;
  height: 4rpx;
  background: #7c6af7;
  border-radius: 2rpx;
}

/* 遮罩 */
.menu-mask {
  display: none;
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}
.menu-mask.show { display: block; }

/* 侧滑菜单 */
.menu-panel {
  position: fixed;
  top: 0; left: -480rpx;
  width: 480rpx;
  height: 100%;
  background: #16162a;
  z-index: 999;
  padding: 120rpx 40rpx 40rpx;
  box-sizing: border-box;
  transition: left 0.3s ease;
  box-shadow: 4rpx 0 20rpx rgba(124,106,247,0.2);
  border-right: 1px solid #2a2a3e;
}
.menu-panel.show { left: 0; }

.menu-item {
  font-size: 34rpx;
  color: #c8c0ff;
  padding: 30rpx 0;
  border-bottom: 1px solid #2a2a3e;
  font-weight: 500;
}

.menu-divider {
  height: 20rpx;
}

/* 通用卡片 */
.card {
  background: #16162a;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  border: 1px solid #2a2a3e;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  box-sizing: border-box;
  width: 100%;
}

/* 头像卡片 */
.profile-card {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #7c6af7;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #e8e8f0;
}

.profile-bio {
  display: block;
  font-size: 24rpx;
  color: #6666aa;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.stat {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #7c6af7;
}

.stat-label {
  font-size: 22rpx;
  color: #6666aa;
}

.stat-divider {
  width: 1px;
  height: 30rpx;
  background: #2a2a3e;
}

/* 天气卡片 */
.weather-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weather-left {
  display: flex;
  flex-direction: column;
}

.weather-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: bold;
  color: #7c6af7;
  line-height: 1;
}

.weather-desc {
  font-size: 24rpx;
  color: #6666aa;
  margin-top: 8rpx;
}

.weather-city {
  font-size: 22rpx;
  color: #444466;
}

.weather-right {
  text-align: right;
}

.weather-day {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #e8e8f0;
  line-height: 1;
}

.weather-weekday {
  display: block;
  font-size: 28rpx;
  color: #7c6af7;
  margin-top: 8rpx;
}

.weather-date {
  display: block;
  font-size: 22rpx;
  color: #444466;
  margin-top: 4rpx;
}

/* 区块标题 */
.section-title {
  font-size: 28rpx;
  color: #7c6af7;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
  display: block;
}

.section-header {
  margin-bottom: 16rpx;
}

/* 分类筛选 */
.cat-tabs {
  display: flex;
  white-space: nowrap;
  margin-top: 16rpx;
}

.cat-tab {
  display: inline-block;
  font-size: 22rpx;
  color: #6666aa;
  background: #1a1a2e;
  border: 1px solid #2a2a3e;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cat-tab.active {
  color: #fff;
  background: #7c6af7;
  border-color: #7c6af7;
}

/* 文章卡片 */
.post-card {
  box-sizing: border-box;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-category {
  font-size: 22rpx;
  color: #7c6af7;
  background: #1e1e3a;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

.post-date {
  font-size: 22rpx;
  color: #444466;
}

.post-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #e8e8f0;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.post-excerpt {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  line-height: 1.7;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.post-read-more {
  margin-top: 20rpx;
}

.post-read-more-text {
  font-size: 24rpx;
  color: #7c6af7;
}

/* 评论卡片 */
.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: bold;
  color: #c8c0ff;
}

.comment-date {
  font-size: 22rpx;
  color: #444466;
}

.comment-content {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.comment-post {
  display: block;
  font-size: 22rpx;
  color: #6666aa;
}

/* 音乐预览卡片 */
.music-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.music-card-icon {
  font-size: 32rpx;
}

.music-card-label {
  font-size: 28rpx;
  color: #7c6af7;
  font-weight: bold;
}

.music-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.music-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #2a2a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.music-note {
  font-size: 44rpx;
  color: #7c6af7;
}

.music-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #e8e8f0;
}

.music-artist {
  display: block;
  font-size: 24rpx;
  color: #6666aa;
  margin-top: 8rpx;
}

.music-goto {
  text-align: right;
}

.music-goto-text {
  font-size: 24rpx;
  color: #7c6af7;
}

/* 主题切换按钮 */
.theme-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 40rpx;
}

/* ====== 浅色模式 ====== */
.light {
  background: #f0f0f5;
}

.light .card {
  background: #ffffff;
  border-color: #e0e0ea;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.light .profile-name {
  color: #1a1a2e;
}

.light .profile-bio {
  color: #888899;
}

.light .stat-label {
  color: #888899;
}

.light .stat-divider {
  background: #e0e0ea;
}

.light .weather-day {
  color: #1a1a2e;
}

.light .weather-date {
  color: #aaaacc;
}

.light .menu-panel {
  background: #ffffff;
  border-right-color: #e0e0ea;
}

.light .menu-item {
  color: #1a1a2e;
  border-bottom-color: #e0e0ea;
}

.light .section-header {
  color: #1a1a2e;
}

.light .cat-tab {
  background: #ececf5;
  border-color: #dcdcea;
  color: #555566;
}

.light .post-title {
  color: #1a1a2e;
}

.light .post-excerpt {
  color: #555566;
}

.light .post-date {
  color: #aaaacc;
}

.light .comment-author {
  color: #1a1a2e;
}

.light .comment-content {
  color: #555566;
}

.light .comment-post {
  color: #aaaacc;
}

.light .music-name {
  color: #1a1a2e;
}

.light .music-artist {
  color: #888899;
}

.theme-btn {
  position: fixed;
  top: 24rpx;
  left: 30rpx;
  z-index: 999;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-icon {
  font-size: 40rpx;
}