/* pages/chat/chat.wxss */
page {
  background: #0f0f1a;
  height: 100%;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  overflow-y: auto;
}

.msg-wrap {
  margin-bottom: 32rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.ai-row { flex-direction: row; }
.user-row { flex-direction: row-reverse; }

/* AI 头像 */
.avatar-ai {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #7c6af7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
  flex-shrink: 0;
}

/* 气泡 */
.bubble {
  max-width: 72%;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.ai-bubble {
  background: #1a1a2e;
  border: 1px solid #2a2a3e;
  border-top-left-radius: 4rpx;
}

.user-bubble {
  background: #7c6af7;
  border-top-right-radius: 4rpx;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #e8e8f0;
  white-space: pre-wrap;
}

/* 加载动画 */
.loading-bubble {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 24rpx 32rpx;
}

.dot {
  font-size: 20rpx;
  color: #7c6af7;
  animation: blink 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #16162a;
  border-top: 1px solid #2a2a3e;
  box-sizing: border-box;
}

.input-field {
  flex: 1;
  background: #0f0f1a;
  border: 1px solid #2a2a3e;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e8e8f0;
  max-height: 200rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #444466;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: #7c6af7;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn.disabled {
  background: #3a3a5a;
}

.send-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

/* 浅色模式 */
.light { background: #f0f0f5; }
.light .msg-list { background: #f0f0f5; }
.light .ai-bubble { background: #ffffff; border-color: #e0e0ea; }
.light .bubble-text { color: #1a1a2e; }
.light .user-bubble .bubble-text { color: #ffffff; }
.light .input-bar { background: #ffffff; border-top-color: #e0e0ea; }
.light .input-field { background: #f5f5fa; border-color: #dcdcea; color: #1a1a2e; }
.light .input-placeholder { color: #aaaacc; }
.light .send-btn.disabled { background: #c0c0d0; }