<view class="container {{darkMode ? 'dark' : 'light'}}">

<!-- 消息列表 -->
<scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
  <view class="msg-wrap" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">

    <!-- AI 消息 -->
    <view class="msg-row ai-row" wx:if="{{item.role === 'assistant'}}">
      <view class="avatar-ai">AI</view>
      <view class="bubble ai-bubble">
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>

    <!-- 用户消息 -->
    <view class="msg-row user-row" wx:else>
      <view class="bubble user-bubble">
        <text class="bubble-text">{{item.content}}</text>
      </view>
    </view>

  </view>

  <!-- 加载中 -->
  <view class="msg-row ai-row" wx:if="{{loading}}">
    <view class="avatar-ai">AI</view>
    <view class="bubble ai-bubble loading-bubble">
      <text class="dot">●</text>
      <text class="dot">●</text>
      <text class="dot">●</text>
    </view>
  </view>

  <view id="bottom"></view>
</scroll-view>

<!-- 输入区 -->
<view class="input-bar">
  <textarea
    class="input-field"
    placeholder="问点什么..."
    placeholder-class="input-placeholder"
    value="{{inputText}}"
    bindinput="onInput"
    auto-height
    maxlength="500"
    confirm-type="send"
    bindconfirm="sendMsg"
    disabled="{{loading}}"
  />
  <view class="send-btn {{loading ? 'disabled' : ''}}" bindtap="sendMsg">
    <text class="send-icon">↑</text>
  </view>
</view>

</view>